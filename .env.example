# Copy this file to ".env" and fill in real values. NEVER commit your .env.
# The OAuth client secret must only ever live in your local .env.

# --- Required (app will not start without these) ---
SAC_AUTH_URL=https://<tenant>.authentication.<region>.hana.ondemand.com/oauth/authorize
SAC_TOKEN_URL=https://<tenant>.authentication.<region>.hana.ondemand.com/oauth/token
SAC_CLIENT_ID=<your client id>
SAC_CLIENT_SECRET=<your client secret>
SAC_REDIRECT_URI=http://localhost:8501
SAC_BASE_URL=https://<tenant>.<region>.analytics.cloud.sap

# --- Optional per-capability IDs (each capability self-guards if left blank) ---
SAC_MODEL_ID=
SAC_EXPORT_PROVIDER_ID=
MA_VERSION_INIT_ID=
